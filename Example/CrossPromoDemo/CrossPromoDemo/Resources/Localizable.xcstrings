        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카탈로그는 읽히지만 앱이 없어서 패키지의 EmptyStateView.noApps가 표시됩니다."
          }
        }
      }
    },
    "The catalog URL does not exist and nothing is cached for it, so the package renders its own EmptyStateView.offline." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
