        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞 케이스와 똑같이 요청이 실패하지만 캐시는 없습니다. 앞의 오래된 목록이 정말 캐시에서 나왔다는 것을 보이는 대조군입니다."
          }
        }
      }
    },
    "The setup did not cache a catalog, so there is no version to compare against." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
