    },
    "The catalog parses but holds no apps, so the package renders its own EmptyStateView.noApps." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カタログは読めますがアプリが1件もないため、パッケージ自身の EmptyStateView.noApps が表示されます。"
